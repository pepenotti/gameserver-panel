{
  "name": "@gsp/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/agent.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@gsp/adapter-api": "*",
    "@gsp/adapters": "*",
    "@gsp/formats": "*",
    "@gsp/shared": "*"
  },
  "devDependencies": {
    "@gsp/adapter-pz": "*"
  }
}
