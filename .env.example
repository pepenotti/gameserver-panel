# Copy to .env with:  node scripts/init-env.mjs   (fills the empty secrets)
# Never commit .env.

# --- Secrets (generated) ---------------------------------------------------
# The password the panel uses with the orchestrator, the part that creates the
# game servers' containers. Each game server's own secrets (the password its
# panel connection uses, its game's admin password) are made when you create
# it, and kept in the panel's database, not here.
ORCH_TOKEN=

# --- Game servers ------------------------------------------------------------
# You create game servers in the panel; each one runs in its own container.
# These settings are the limits the panel must stay within.
#
# Your time zone (tz database name, e.g. Europe/Madrid); schedules and logs use it.
TZ=UTC
# The ports on this machine that game servers may use, as single ports or
# ranges, separated by commas (all 1024 or above). The panel picks free ones
# from here for each new server (you can also choose them), and refuses any
# other. Forward the ones your servers use in your router. The defaults cover
# Valheim (2456-), Terraria (7777-), Project Zomboid (16261-) and Minecraft (25565-).
ORCH_HOST_PORTS=2456-2499,7777-7799,16261-16299,25565-25599
# The most memory one server may be given, in MiB. It is a hard limit for that
# server's container: the game's own memory (set per server in the panel) plus
# what the game needs around it. A Project Zomboid server needs its game
# memory + 3 GB. Keep the total of your servers under what this machine has.
ORCH_MAX_MEM_MB=16384
# How many game servers this machine may have.
ORCH_MAX_SERVERS=10
# 1 allows the fake game servers used for tests and development. Keep 0.
ORCH_ALLOW_FAKE=0
# Which kind of game server image new servers run: empty for the real games
# (the normal choice); "fake" for fake games that download nothing (tests and
# development slots only; needs ORCH_ALLOW_FAKE=1).
SERVER_IMAGE_VARIANT=

# --- Panel -------------------------------------------------------------------
# The name people type to reach the panel (a DDNS name such as yourname.ddns.net),
# and its port. 8443 leaves 80/443 free for another web server on the same host.
# Not "localhost" or the LAN_IP: the panel already answers on those, and Caddy
# refuses to start when the same address is listed twice. panel.localhost
# points at this machine in browsers, and https://localhost:8443 works too.
PANEL_HOST=panel.localhost
PANEL_PORT=8443
# This machine's address on your network; the panel also answers on it.
LAN_IP=127.0.0.1
# First boot only: creates the owner account (forced password change + 2FA at first login).
PANEL_OWNER_USERNAME=owner
PANEL_OWNER_PASSWORD=
# Certificate for PANEL_HOST. internal = self-signed (browsers warn).
# duckdns = real Let's Encrypt certificate: also set PANEL_HOST=<name>.duckdns.org,
# DUCKDNS_SUBDOMAIN=<name>, DUCKDNS_TOKEN and COMPOSE_PROFILES=duckdns (the updater).
PANEL_TLS=internal
DUCKDNS_SUBDOMAIN=
# From duckdns.org after signing in. A secret: it controls the name.
DUCKDNS_TOKEN=
# Extra services to run: duckdns (DuckDNS updater), public (No-IP updater).
COMPOSE_PROFILES=
# Where finished backup archives go (a folder on the host), e.g. D:/zomboid-backups on Windows.
BACKUP_DIR=./backups
# Docker Desktop shows every client as the same IP: keep false there, true on a Linux host.
CLIENT_IP_TRUSTWORTHY=false
# Memory cap for the panel container.
PANEL_MEM_LIMIT=1g

# --- Docker ------------------------------------------------------------------
# Address the published ports (the panel's and the game servers') listen on;
# empty means every address (0.0.0.0).
# Development worktrees use 127.0.0.1 (scripts/worktree-env.mjs).
PUBLISH_ADDR=
# Tag of the locally built images: gsp/orchestrator, gsp/panel, gsp/caddy and
# the runtime images game servers run (gsp/steam, gsp/steam-fake).
IMAGE_TAG=local

# --- Optional: No-IP updater (docker compose --profile public up -d) --------
# A DDNS Key from No-IP (Dynamic DNS > DDNS Keys), not the account password.
# all.ddnskey.com updates every hostname linked to that key.
NOIP_USERNAME=
NOIP_PASSWORD=
NOIP_HOSTNAMES=all.ddnskey.com
