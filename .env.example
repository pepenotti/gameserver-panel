# Copy to .env with:  node scripts/init-env.mjs   (fills the empty secrets)
# Never commit .env.

# --- Secrets (generated) ---------------------------------------------------
# Panel <-> agent API token.
AGENT_TOKEN=
# Password of the in-game `admin` account; the panel passes it on every start.
PZ_ADMIN_PASSWORD=

# --- Game server -------------------------------------------------------------
# Names the ini, sandbox file and save folder. Changing it later means a new world.
PZ_SERVER_NAME=zomboid
PZ_GAME_PORT=16261
PZ_UDP_PORT=16262
# Hard memory cap for the game container; keep it ~3 GB above the Java heap set in the panel.
PZ_MEM_LIMIT=12g
# Your time zone (tz database name, e.g. Europe/Madrid); schedules and logs use it.
TZ=UTC

# --- Panel -------------------------------------------------------------------
# The name people type to reach the panel (a DDNS name such as yourname.ddns.net),
# and its port. 8443 leaves 80/443 free for another web server on the same host.
# Not "localhost" or the LAN_IP: the panel already answers on those, and Caddy
# refuses to start when the same address is listed twice. panel.localhost
# points at this machine in browsers, and https://localhost:8443 works too.
PANEL_HOST=panel.localhost
PANEL_PORT=8443
# This machine's address on your network; the panel also answers on it.
LAN_IP=127.0.0.1
# First boot only: creates the owner account (forced password change + 2FA at first login).
PANEL_OWNER_USERNAME=owner
PANEL_OWNER_PASSWORD=
# Certificate for PANEL_HOST. internal = self-signed (browsers warn).
# duckdns = real Let's Encrypt certificate: also set PANEL_HOST=<name>.duckdns.org,
# DUCKDNS_SUBDOMAIN=<name>, DUCKDNS_TOKEN and COMPOSE_PROFILES=duckdns (the updater).
PANEL_TLS=internal
DUCKDNS_SUBDOMAIN=
# From duckdns.org after signing in. A secret: it controls the name.
DUCKDNS_TOKEN=
# Extra services to run: duckdns (DuckDNS updater), public (No-IP updater).
COMPOSE_PROFILES=
# Where finished backup archives go (a folder on the host), e.g. D:/zomboid-backups on Windows.
BACKUP_DIR=./backups
# Docker Desktop shows every client as the same IP: keep false there, true on a Linux host.
CLIENT_IP_TRUSTWORTHY=false
# Memory cap for the panel container.
PANEL_MEM_LIMIT=1g

# --- Docker ------------------------------------------------------------------
# Address the published ports listen on; empty means every address (0.0.0.0).
# Development worktrees use 127.0.0.1 (scripts/worktree-env.mjs).
PUBLISH_ADDR=
# Tag of the locally built images gsp/pz, gsp/panel and gsp/caddy.
IMAGE_TAG=local

# --- Optional: No-IP updater (docker compose --profile public up -d) --------
# A DDNS Key from No-IP (Dynamic DNS > DDNS Keys), not the account password.
# all.ddnskey.com updates every hostname linked to that key.
NOIP_USERNAME=
NOIP_PASSWORD=
NOIP_HOSTNAMES=all.ddnskey.com
